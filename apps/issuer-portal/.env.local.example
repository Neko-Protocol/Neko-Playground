# --- Stellar ---
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_XLM_SAC=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# v2: Neko Listing Registry contract id (replaces the old distributor).
NEXT_PUBLIC_NEKO_LISTING_REGISTRY_CONTRACT_ID=

# Public base URL of the portal. For DIDIT real KYC this MUST be the HTTPS
# ngrok URL (DIDIT needs to POST the webhook). Run:
#   ngrok http 3001
# and paste the https URL here, then restart `npm run dev`.
NEXT_PUBLIC_APP_URL=

# --- Admin ---
# Used for mock-mode escrow, server-side release/cancel helpers, and TW
# `update-escrow` / `release-milestone-funds` signing (may need alignment if TW
# binds release to the listing wallet from deploy).
NEKO_ADMIN_PUBLIC_KEY=
NEKO_ADMIN_SECRET_KEY=
# Receives Neko’s on-chain XLM fee from `neko-listing-registry.buy` (not the TW API).
NEKO_FEE_ADDRESS=

# Legacy: TW multi-release deploy now sets every role + signer to the listing
# `issuerAddress` from `/api/escrow/create` (optional `trustlineAddress` for
# `trustline.address` only). This variable is unused by the current deploy payload.
TRUSTLESS_WORK_PLATFORM_ADDRESS=

# Optional classic asset issuer (G…) for `trustline: { issuer, symbol }` when TW
# requires that shape. Otherwise `trustline.address` defaults to `issuerAddress`
# or the optional `trustlineAddress` field on the create API.
TRUSTLESS_WORK_TRUSTLINE_ISSUER=

# --- Trustless Work ---
# Leave TRUSTLESS_WORK_API_KEY empty to run in MOCK mode (the Neko admin
# acts as escrow custodian; releases are direct token transfers signed
# server-side). Set the key to switch to the real TW REST API.
#
# API keys are environment-specific: a **Testnet** key from TW BackOffice must
# use TRUSTLESS_WORK_API_URL=https://dev.api.trustlesswork.com ; a **Mainnet**
# key must use https://api.trustlesswork.com . Mixing key + URL returns 401.
TRUSTLESS_WORK_API_URL=https://dev.api.trustlesswork.com
TRUSTLESS_WORK_API_KEY=

# --- Reflector oracles (testnet defaults for the issuer dropdown) ---
NEXT_PUBLIC_REFLECTOR_ORACLE_STELLAR=CAVLP5DH2GJPZMVO7IJY4CVOD5MWEFTJFVPD2YY2FQXOQHRGHK4D6HLP
NEXT_PUBLIC_REFLECTOR_ORACLE_EXTERNAL=CCYOZJCOPG34LLQQ7N24YXBM7LL62R7ONMZ3G6WZAAYPB5OYKOMJRN63
NEXT_PUBLIC_REFLECTOR_ORACLE_FX=CCSSOHTBL3LEWUCBBEB5NJFC2OKFRC74OWEIJIZLRJBGAAU4VMU5NV4W

# --- DIDIT (real KYC) ---
# workflow_id UUIDs from https://business.didit.me (NOT the shared-link URLs).
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=
DIDIT_WORKFLOW_BASIC=
DIDIT_WORKFLOW_ACCREDITED=
DIDIT_WORKFLOW_INSTITUTIONAL=

# In the DIDIT portal, on each workflow configure:
#   Webhook URL  = ${NEXT_PUBLIC_APP_URL}/api/kyc/webhook
#   Success URL  = ${NEXT_PUBLIC_APP_URL}/issuer/list?kyc=pending
#   Decline URL  = ${NEXT_PUBLIC_APP_URL}/issuer/list

# --- Offline fallback (optional) ---
# Leave unset (or "false") for real DIDIT.
# NEXT_PUBLIC_DIDIT_MOCK=false
