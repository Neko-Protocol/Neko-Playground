# Stellar Network Configuration (mainnet value must be PUBLIC, not MAINNET)
# Switching to PUBLIC requires mainnet entries in lib/constants/contractsByNetwork.ts
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# SoroSwap ApiKey
NEXT_PUBLIC_SOROSWAP_API_KEY=

# Faucet contract (client-side, permissionless on testnet)
# The faucet contract is the admin of all RWA tokens and handles set_authorized + mint.
# Users call bulk_mint directly via Freighter (no server-side key needed).
NEXT_PUBLIC_FAUCET_CONTRACT_ID=

# Lending admin address (server-only). Stellar public key allowed into /dashboard/admin.
# Not a secret, but kept server-side so it is not bundled as a client gate constant.
# Admin must connect wallet (sets cookie) before visiting /dashboard/admin.
LENDING_ADMIN_ADDRESS=

# Vault manager key — server-only, never expose to client
VAULT_MANAGER_SECRET_KEY=

# Etherfuse FX — server-only (no NEXT_PUBLIC_ prefix)
ETHERFUSE_API_KEY=
ETHERFUSE_BASE_URL=https://api.sand.etherfuse.com

# Alfred Pay — server-only
ALFREDPAY_API_KEY=
ALFREDPAY_API_SECRET=
ALFREDPAY_BASE_URL=https://api-service-co.alfredpay.app/api/v1/third-party-service/penny
ALFREDPAY_WEBHOOK_SECRET=

NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Auth — server-only (Upstash Redis + session signing)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
AUTH_SESSION_SECRET=
# Set to false for local dev without Redis (not for production)
AUTH_ENFORCEMENT=true